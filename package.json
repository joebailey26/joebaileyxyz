{
  "name": "joebaileyxyz",
  "version": "1.0.0",
  "description": "Website for Joe Bailey",
  "author": "Joe Bailey",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "pnpm run generate",
    "deploy": "pnpm run build && wrangler deploy",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "cms:dev": "pnpm --dir cms run dev",
    "cms:test": "pnpm --dir cms run test",
    "cms:build": "pnpm --dir cms run build",
    "test:contact": "node --test --test-isolation=none worker/test/*.test.ts",
    "typecheck": "nuxt typecheck",
    "lint:scripts": "eslint .",
    "fix:scripts": "eslint . --fix",
    "lint:styles": "stylelint \"**/*.{vue,scss}\"",
    "fix:styles": "stylelint \"**/*.{vue,scss}\" --fix"
  },
  "dependencies": {
    "@fontsource/rammetto-one": "^5.2.7",
    "@fontsource/recursive": "^5.2.8",
    "@fontsource/roboto": "^5.2.9",
    "@fontsource/roboto-slab": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@joebailey26/nuxt-static-wordpress": "^0.1.0",
    "@torchlight-api/client": "^0.0.4",
    "nuxt": "^4.6.2",
    "nuxt-component-date": "git+https://github.com/Galexia-Agency/nuxt-component-date.git#0b7351eee27645e0a4a64172e46d40b3b87b6a61",
    "nuxt-component-pagination": "git+https://github.com/Galexia-Agency/nuxt-component-pagination.git#dd4d0bea6b2853a977b5a97528c0b286a40534ba",
    "sass": "^1.97.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-galexia": "git+https://github.com/Galexia-Agency/eslint-config.git#e94753a7ed8a94ae746f5f6ccf605ce288565ff2",
    "globals": "^17.0.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^15.11.0",
    "stylelint-config-galexia": "git+https://github.com/Galexia-Agency/stylelint-config.git#861ee9c7f547f05547658dd78de8519e80c9a23f",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.151.3"
  },
  "browserslist": [
    "last 5 versions and not ie <= 11 and > 0.2% and not dead and not op_mini all"
  ],
  "engines": {
    "node": "^24.18.0",
    "pnpm": "^10.11.1"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "core-js",
      "core-js-pure",
      "nuxt"
    ]
  }
}
