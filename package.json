{
  "name": "joebaileyxyz",
  "version": "1.0.0",
  "description": "Website for Joe Bailey",
  "author": "Joe Bailey",
  "private": true,
  "scripts": {
    "dev": "nuxt",
    "start": "nuxt start",
    "build": "pnpm run generate",
    "deploy": "pnpm run build && wrangler deploy",
    "generate": "nuxt generate --modern --quiet --fail-on-error",
    "cms:dev": "pnpm --dir cms run dev",
    "cms:test": "pnpm --dir cms run test",
    "cms:build": "pnpm --dir cms run build",
    "test:contact": "node --test --test-isolation=none worker/test/*.test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "lint:scripts": "eslint --ext .js,.vue --ignore-path .gitignore .",
    "fix:scripts": "eslint --ext .js,.vue --ignore-path .gitignore . --fix",
    "lint:styles": "stylelint \"**/*.{vue,scss}\"",
    "fix:styles": "stylelint \"**/*.{vue,scss}\" --fix"
  },
  "dependencies": {
    "@aceforth/nuxt-optimized-images": "^1.4.0",
    "@fontsource/rammetto-one": "^5.2.7",
    "@fontsource/recursive": "^5.2.8",
    "@fontsource/roboto": "^5.2.9",
    "@fontsource/roboto-slab": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^2.0.10",
    "@torchlight-api/client": "^0.0.4",
    "cheerio": "^1.1.2",
    "ffmpeg-static": "^5.3.0",
    "fs": "^0.0.2",
    "he": "^1.2.0",
    "node-gyp": "^10.3.1",
    "nuxt": "^2.17.3",
    "nuxt-component-date": "git+https://github.com/Galexia-Agency/nuxt-component-date.git#21ef623712edf203291198a29e08d70a34b9cd03",
    "nuxt-component-image": "git+https://github.com/Galexia-Agency/nuxt-component-image.git#cd07c5a817f87e7251b86fc8ee1f8d57208486b7",
    "nuxt-component-pagination": "git+https://github.com/Galexia-Agency/nuxt-component-pagination.git#bd4a821dba7df3e3c1f5f8a01ae7f4168708d514",
    "nuxt-component-share": "git+https://github.com/Galexia-Agency/nuxt-component-share.git#dd238ac7d1996099896cc8e5a9c835329bd94840",
    "path": "^0.12.7",
    "responsive-loader": "^2.3.0",
    "sass": "^1.97.2",
    "sass-loader": "^10.5.2",
    "sharp": "^0.34.5",
    "striptags": "^3.2.0"
  },
  "devDependencies": {
    "@nuxt/typescript-build": "^3.0.2",
    "@nuxtjs/eslint-module": "^3.1.0",
    "@nuxtjs/stylelint-module": "^4.2.2",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-galexia": "git+https://github.com/Galexia-Agency/eslint-config.git#a23a23534644dce9c1b2b97a41f1917e885aa532",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^15.11.0",
    "stylelint-config-galexia": "git+https://github.com/Galexia-Agency/stylelint-config.git#861ee9c7f547f05547658dd78de8519e80c9a23f",
    "typescript": "^5.4.3",
    "wrangler": "4.151.3"
  },
  "browserslist": [
    "last 5 versions and not ie <= 11 and > 0.2% and not dead and not op_mini all"
  ],
  "engines": {
    "node": "^24.18.0",
    "pnpm": "^10.11.1"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static",
      "sharp",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "core-js",
      "core-js-pure",
      "nuxt"
    ]
  }
}
