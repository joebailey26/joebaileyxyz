{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joebailey-cms",
  "account_id": "8259f9bfa45a74a587d6a90822de442d",
  "main": "worker.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "cms.joebailey.xyz", "custom_domain": true }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "joebailey-cms",
    "database_id": "d44d3f1e-5613-4729-9ced-48f0ad6ae097",
    "migrations_dir": "node_modules/@joebailey26/static-wordpress/migrations"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "joebailey-cms-files" }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "galexia.cloudflareaccess.com",
    "ACCESS_AUD": "21a71f109f6250625cf12effeb8d5ee76c4d14d9e0407d5ba341b7e56c8767d8",
    "CF_ACCOUNT_ID": "8259f9bfa45a74a587d6a90822de442d",
    "CF_WORKER_TAG": "081e89f4489d43c18284408c4f2ded01",
    "SITE_BRANCH": "master"
  },
  "previews": {
    "d1_databases": [{
      "binding": "DB",
      "database_name": "joebailey-cms-preview",
      "database_id": "1d12eb8a-f1b8-436c-b98a-fac609b026c0",
      "migrations_dir": "node_modules/@joebailey26/static-wordpress/migrations"
    }],
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "joebailey-cms-preview-files" }],
    "vars": {
      "ACCESS_TEAM_DOMAIN": "galexia.cloudflareaccess.com",
      "ACCESS_AUD": "cbdf5790493a5899e171ba32d7b8393b606a3683442c80ac02074c44f91b341e",
      "CMS_TRIGGER_BUILDS": "false"
    }
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
