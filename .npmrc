# eslint-config-galexia is installed from git and imports @stylistic/eslint-plugin without
# declaring it as a dependency, so it must resolve from a flat node_modules tree.
node-linker=hoisted
# @joebailey26 packages (the static-wordpress CMS) come from GitHub Packages, which needs a read:packages token.
@joebailey26:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
